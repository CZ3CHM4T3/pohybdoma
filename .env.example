# Šablona proměnných prostředí pro POHYB DOMA.
# Zkopíruj tento soubor jako ".env.local" a doplň reálné hodnoty.
# .env.local se NEcommituje (je v .gitignore) – klíče zůstanou v bezpečí.
# Na produkci se tyhle proměnné nastavují ve Vercelu (Settings → Environment Variables).

# ── Supabase ──
# Project URL a anon public klíč: Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role klíč je TAJNÝ – jen na serveru, nikdy v prohlížeči ani v gitu.
# Potřeba pro server-side admin operace (Stripe webhook apod.).
SUPABASE_SERVICE_ROLE_KEY=

# ── Adresa webu ──
# Použije se v odkazech (Stripe návraty apod.). Na produkci https://pohybdoma.cz
NEXT_PUBLIC_SITE_URL=https://pohybdoma.cz

# ── Soukromá brána (soft-launch) ──
# Když je nastaveno, web je za přístupovým kódem (veřejné jsou jen výloha,
# rezervace a blog). Po ostrém spuštění tuto proměnnou SMAŽ (brána zmizí, aktivuje se SEO).
SITE_ACCESS_CODE=pohyb2026

# ── Preview / demo režim ──
# "off" = registrace zapnutá a bez demo přepínače. Jinak preview režim.
NEXT_PUBLIC_PREVIEW_MODE=off

# ── Ecomail (newsletter) ──
# Veřejná adresa přihlašovacího formuláře (Ecomail → formulář → veřejný odkaz).
ECOMAIL_SUBSCRIBE_URL=

# ── Stripe (platby/předplatné – aktivuje se, až budeš prodávat) ──
# Klíče: Stripe Dashboard → Developers → API keys; Price ID u produktů; webhook secret u endpointu.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MEMBER=
STRIPE_PRICE_VIP=
STRIPE_PRICE_VIP_PLUS=

# ── Záloha databáze (GitHub Actions) ──
# NE do .env – tohle je secret v GitHubu (Settings → Secrets → Actions): SUPABASE_DB_PASSWORD

# ── Resend (transakční e-maily) ──
# NE do .env – API klíč se ukládá v Supabase do private.app_config (resend_api_key),
# odkud ho čtou databázové triggery (potvrzení rezervace, upomínky).
